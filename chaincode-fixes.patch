+	callerOrg, err := ctx.GetClientIdentity().GetMSPID()
+	if err != nil {
+		return false, err
+	}
+	if callerOrg != "HospitalMSP" && callerOrg != granteeOrg {
+		return false, fmt.Errorf(
+			"access denied: %s may not query consent on behalf of %s",
+			callerOrg,
+			granteeOrg,
+		)
+	}
+
