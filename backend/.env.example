JWT_SECRET=
MONGO_URI=mongodb://localhost:27017/medvault
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MEDVLT
MSG91_TEMPLATE_ID=
GMAIL_USER=
GMAIL_PASS=
# Required in production. Generate with: openssl rand -hex 32
AADHAAR_HASH_SECRET=
# KMS key-encryption key (KEK) that wraps every per-document key. 64 hex chars.
# Prefer KMS_KEK_FILE pointing at a 0600 file outside the repository; KMS_KEK is the fallback.
# Generate with: openssl rand -hex 32
# The backend does not load this file by itself: export these in the shell that starts it
# (and the kms:migrate / kms:rotate-kek scripts), or start with: node --env-file=.env server.js
KMS_KEK_FILE=
KMS_KEK=
