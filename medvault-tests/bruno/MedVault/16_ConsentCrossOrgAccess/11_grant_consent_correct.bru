meta {
  name: Grant Consent - PharmacyMSP for PRESCRIPTION (correct)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/consents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patient_token}}
}

script:pre-request {
  bru.setVar("cross_org_consent_id_new", "CON" + Date.now());
}

body:json {
  {
    "consentID": "{{cross_org_consent_id_new}}",
    "patientID": "{{patient_id}}",
    "granteeOrg": "PharmacyMSP",
    "resourceType": "PRESCRIPTION",
    "permission": "READ",
    "expiryDate": "2027-12-31T00:00:00.000Z"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("consentID returned", function() {
    expect(res.body.consentID).to.be.a("string");
    bru.setEnvVar("cross_org_consent_id", res.body.consentID);
  });
}
