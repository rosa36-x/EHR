meta {
  name: Grant Consent - PharmacyMSP for LAB_REPORT (wrong type for this test)
  type: http
  seq: 7
}

post {
  url: {{base_url}}/consents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patient_token}}
}

script:pre-request {
  bru.setVar("wrong_type_consent_id_new", "CON" + Date.now());
}

body:json {
  {
    "consentID": "{{wrong_type_consent_id_new}}",
    "patientID": "{{patient_id}}",
    "granteeOrg": "PharmacyMSP",
    "resourceType": "LAB_REPORT",
    "permission": "READ",
    "expiryDate": "2027-12-31T00:00:00.000Z"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
}
