meta {
  name: Register Governance Org Actor
  type: http
  seq: 22
}

post {
  url: {{base_url}}/auth/org-actor/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("governance_actor_phone", "7" + Date.now().toString().slice(-9));
  bru.setVar("governance_actor_email", "governance" + Date.now() + "@medvault.test");
  bru.setVar("governance_actor_password", "GovernancePass123!");
}

body:json {
  {
    "fullName": "Gita Governance",
    "org": "GovernanceMSP",
    "phone": "{{governance_actor_phone}}",
    "email": "{{governance_actor_email}}",
    "password": "{{governance_actor_password}}"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("actorID has ORG prefix", function() {
    expect(res.body.actorID).to.be.a("string");
    expect(res.body.actorID).to.match(/^ORG/);
  });
}
