meta {
  name: Login Governance Org Actor
  type: http
  seq: 23
}

post {
  url: {{base_url}}/auth/org-actor/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{governance_actor_phone}}",
    "password": "{{governance_actor_password}}"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("JWT token returned", function() {
    expect(res.body.token).to.be.a("string");
    expect(res.body.token.split(".").length).to.equal(3);
  });
  test("org is GovernanceMSP", function() {
    expect(res.body.org).to.equal("GovernanceMSP");
  });
}
