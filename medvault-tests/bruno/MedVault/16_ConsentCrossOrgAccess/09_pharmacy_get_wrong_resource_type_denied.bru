meta {
  name: Pharmacy Get Prescription - Wrong Resource Type Consent - Denied
  type: http
  seq: 9
}

get {
  url: {{base_url}}/prescriptions/{{cross_org_prescription_id}}?org=pharmacy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pharmacy_actor_token}}
}

tests {
  // Patient has an active consent to PharmacyMSP, but only for LAB_REPORT
  // (granted in 07). A PRESCRIPTION read must still be denied — the
  // consent index is keyed on (patientID, granteeOrg, resourceType), so a
  // grant for one resourceType must never leak into another.
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("ACCESS_DENIED status", function() {
    expect(res.body.status).to.equal("ACCESS_DENIED");
  });
}
