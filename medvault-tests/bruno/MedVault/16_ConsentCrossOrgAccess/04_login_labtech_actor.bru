meta {
  name: Login Lab-Tech Org Actor
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/org-actor/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{labtech_actor_phone}}",
    "password": "{{labtech_actor_password}}"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("JWT token returned", function() {
    expect(res.body.token).to.be.a("string");
    bru.setEnvVar("labtech_actor_token", res.body.token);
  });
  test("org is LaboratoryMSP", function() {
    expect(res.body.org).to.equal("LaboratoryMSP");
  });
}
