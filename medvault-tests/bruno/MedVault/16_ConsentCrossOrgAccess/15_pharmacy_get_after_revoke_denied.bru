meta {
  name: Pharmacy Get Prescription - After Revoke - Denied
  type: http
  seq: 15
}

get {
  url: {{base_url}}/prescriptions/{{cross_org_prescription_id}}?org=pharmacy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pharmacy_actor_token}}
}

tests {
  // HasActiveConsent is a live ledger read on every call — no JS-side cache
  // to go stale, so this must deny immediately after the revoke in 14.
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("ACCESS_DENIED status", function() {
    expect(res.body.status).to.equal("ACCESS_DENIED");
  });
}
