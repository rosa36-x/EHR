meta {
  name: Pharmacy Get Prescription - No Active Consent - Denied
  type: http
  seq: 7
}

get {
  url: {{base_url}}/prescriptions/{{cross_org_prescription_id}}?org=pharmacy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pharmacy_actor_token}}
}

tests {
  // Relies on 06's baseline (Pharmacy/PRESCRIPTION forced to REVOKED), not
  // on this patient having zero consent history — the ledger persists
  // across reruns, so "never granted" isn't a safe thing to assert here.
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("ACCESS_DENIED status", function() {
    expect(res.body.status).to.equal("ACCESS_DENIED");
  });
}
