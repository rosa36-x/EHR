meta {
  name: Grant Consent - Already Expired
  type: http
  seq: 17
}

post {
  url: {{base_url}}/consents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patient_token}}
}

script:pre-request {
  bru.setVar("expired_consent_id_new", "CON" + Date.now());
}

body:json {
  {
    "consentID": "{{expired_consent_id_new}}",
    "patientID": "{{patient_id}}",
    "granteeOrg": "PharmacyMSP",
    "resourceType": "PRESCRIPTION",
    "permission": "READ",
    "expiryDate": "2020-01-01T00:00:00.000Z"
  }
}

tests {
  // This overwrites the CON_IDX_<patient>_PharmacyMSP_PRESCRIPTION index
  // from 11/14 with this new, already-expired consent — "latest grant wins".
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
}
