meta {
  name: IPFS Upload File
  type: http
  seq: 1
}
post {
  url: {{base_url}}/ipfs/upload
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  const data = new FormData();
  data.append("file", fs.createReadStream("/tmp/test_ipfs_payload.pdf"));

  req.setBody(data);
  req.setHeaders(data.getHeaders());
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("success true", function() {
    expect(res.body.success).to.equal(true);
  });
  test("CID returned", function() {
    expect(res.body.cid).to.be.a("string");
    expect(res.body.cid.length).to.be.at.least(10);
    bru.setEnvVar("ipfs_test_cid", res.body.cid);
  });
}
