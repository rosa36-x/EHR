meta {
  name: Create Prescription
  type: http
  seq: 1
}
post {
  url: {{base_url}}/prescriptions
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  bru.setVar("prescription_id_new", "PRE" + Date.now());

  const data = new FormData();
  data.append("prescriptionID", bru.getVar("prescription_id_new"));
  data.append("patientID", bru.getEnvVar("patient_id"));
  data.append("doctorID", bru.getEnvVar("doctor_id"));
  data.append("recordType", "GENERAL");
  data.append("file", fs.createReadStream("/tmp/test_prescription.pdf"));

  req.setBody(data);
  const headers = data.getHeaders();
  headers["Authorization"] = "Bearer " + bru.getEnvVar("doctor_token");
  req.setHeaders(headers);
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("prescriptionID returned", function() {
    bru.setEnvVar("prescription_id", res.body.prescriptionID);
  });
  test("sensitivityLevel NORMAL", function() {
    expect(res.body.sensitivityLevel).to.equal("NORMAL");
  });
  test("CID and keyRef returned", function() {
    expect(res.body.prescriptionCID).to.be.a("string");
    expect(res.body.encryptionKeyRef).to.match(/^KEY/);
  });
}
