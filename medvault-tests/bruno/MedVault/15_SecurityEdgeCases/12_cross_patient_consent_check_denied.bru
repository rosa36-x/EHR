meta {
  name: Security - Cross-Patient Consent Check-Active Denied
  type: http
  seq: 12
}

get {
  url: {{base_url}}/consents/{{consent_id}}/check
  body: none
  auth: bearer
}

auth:bearer {
  token: {{second_patient_token}}
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("ACCESS_DENIED status", function() {
    expect(res.body.status).to.equal("ACCESS_DENIED");
  });
  test("isActive not leaked to non-owner", function() {
    expect(res.body.isActive).to.equal(undefined);
  });
}
