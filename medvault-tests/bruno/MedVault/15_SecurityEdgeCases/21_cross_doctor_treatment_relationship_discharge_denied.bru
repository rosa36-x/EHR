meta {
  name: Security - Cross-Doctor Treatment Relationship Discharge Denied
  type: http
  seq: 21
}

script:pre-request {
  const base = bru.getEnvVar("base_url");

  // Fresh relationship owned by {{doctor_token}}/{{doctor_id}}, independent
  // of {{treatment_relationship_id}} which 05_TreatmentRelationship already
  // cycles through dormant/reactivate.
  const createRes = await fetch(base + "/treatment-relationships", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": "Bearer " + bru.getEnvVar("doctor_token")
    },
    body: JSON.stringify({
      patientID: bru.getEnvVar("patient_id"),
      relationshipType: "RECENT_APPOINTMENT",
      notes: "Relationship created for cross-doctor discharge-denial test"
    })
  });
  const createData = await createRes.json();
  if (createRes.status !== 200 || !createData.relationshipID) {
    throw new Error("Pre-request setup failed creating treatment relationship: " + createRes.status + " - " + JSON.stringify(createData));
  }
  bru.setVar("cross_doctor_tr_id", createData.relationshipID);

  // Mint an unrelated second doctor who has nothing to do with this relationship.
  const phone = "90" + Math.floor(10000000 + Math.random() * 89999999);
  const email = "otherdoctor" + Date.now() + "@hospital.test";

  const regRes = await fetch(base + "/doctors/register", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      fullName: "Dr. Not Assigned",
      email: email,
      phone: phone,
      password: "TestPass123!",
      specialization: "General Medicine",
      hospitalID: "HOSP001",
      licenseNumber: "NMC" + Date.now().toString().slice(-8)
    })
  });
  const regData = await regRes.json();
  if (regRes.status !== 200) {
    throw new Error("Pre-request setup failed registering second doctor: " + regRes.status + " - " + JSON.stringify(regData));
  }

  const loginRes = await fetch(base + "/auth/doctor/login", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ phone: phone, password: "TestPass123!" })
  });
  const loginData = await loginRes.json();
  if (loginRes.status !== 200 || !loginData.token) {
    throw new Error("Pre-request setup failed logging in second doctor: " + loginRes.status + " - " + JSON.stringify(loginData));
  }
  bru.setVar("unrelated_doctor_token", loginData.token);
}

patch {
  url: {{base_url}}/treatment-relationships/{{cross_doctor_tr_id}}/discharge
  body: none
  auth: bearer
}

auth:bearer {
  token: {{unrelated_doctor_token}}
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("ACCESS_DENIED status", function() {
    expect(res.body.status).to.equal("ACCESS_DENIED");
  });
}
