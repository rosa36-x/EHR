meta {
  name: Security - Invalid recordType on Consultation Create
  type: http
  seq: 7
}

post {
  url: {{base_url}}/consultations
  body: multipartForm
  auth: none
}

script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');
  const data = new FormData();
  data.append("consultationID", "CONS_INVALID_TYPE_TEST_" + Date.now());
  data.append("patientID", bru.getEnvVar("patient_id"));
  data.append("doctorID", bru.getEnvVar("doctor_id"));
  data.append("diagnosis", "Test diagnosis");
  data.append("recordType", "NOT_A_REAL_TYPE");
  data.append("file", fs.createReadStream("/tmp/test_consultation.pdf"));
  req.setBody(data);
  const headers = data.getHeaders();
  headers["Authorization"] = "Bearer " + bru.getEnvVar("doctor_token");
  req.setHeaders(headers);
}

tests {
  test("status 500", function() {
    expect(res.status).to.equal(500);
  });
  test("FAILED status", function() {
    expect(res.body.status).to.equal("FAILED");
  });
  test("error mentions invalid recordType", function() {
    expect(res.body.message.includes("recordType") || res.body.message.includes("Invalid")).to.equal(true);
  });
}
