meta {
  name: Security - Access Record Without Treatment Relationship
  type: http
  seq: 8
}

script:pre-request {
  const phone = "90" + Math.floor(10000000 + Math.random() * 89999999);
  const email = "seconddoc" + Date.now() + "@hospital.test";
  const regRes = await fetch(bru.getEnvVar("base_url") + "/doctors/register", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      fullName: "Dr. No Relationship",
      email: email,
      phone: phone,
      password: "TestPass123!",
      specialization: "General Medicine",
      hospitalID: "HOSP001",
      licenseNumber: "NMC" + Date.now().toString().slice(-8)    })
  });
  const regData = await regRes.json();
  console.log("REGISTER STATUS:", regRes.status, JSON.stringify(regData));
  if (regRes.status !== 200) {
    throw new Error("Pre-request setup failed: doctor registration returned " + regRes.status + " - " + JSON.stringify(regData));
  }
  const loginRes = await fetch(bru.getEnvVar("base_url") + "/auth/doctor/login", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ phone: phone, password: "TestPass123!" })
  });
  const loginData = await loginRes.json();
  console.log("LOGIN STATUS:", loginRes.status, JSON.stringify(loginData));
  if (loginRes.status !== 200 || !loginData.token) {
    throw new Error("Pre-request setup failed: doctor login returned " + loginRes.status + " - " + JSON.stringify(loginData));
  }
  bru.setVar("second_doctor_token", loginData.token);
}

get {
  url: {{base_url}}/consultations/{{consultation_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{second_doctor_token}}
}

tests {
  test("ACCESS_DENIED without treatment relationship", function() {
    expect(res.status).to.equal(403);
    expect(res.body.status).to.equal("ACCESS_DENIED");
  });
  test("error mentions treatment relationship", function() {
    expect(res.body.message).to.include("treatment relationship");
  });
}
