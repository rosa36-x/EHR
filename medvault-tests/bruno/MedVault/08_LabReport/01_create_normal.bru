meta {
  name: Create Lab Report (Normal)
  type: http
  seq: 1
}
post {
  url: {{base_url}}/labreports
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  bru.setVar("lab_report_id_new", "LAB" + Date.now());

  const data = new FormData();
  data.append("reportID", bru.getVar("lab_report_id_new"));
  data.append("patientID", bru.getEnvVar("patient_id"));
  data.append("labTechID", "LABTECH001");
  data.append("reportType", "BLOOD_TEST");
  data.append("file", fs.createReadStream("/tmp/test_labreport.pdf"));

  req.setBody(data);
  const headers = data.getHeaders();
  headers["Authorization"] = "Bearer " + bru.getEnvVar("doctor_token");
  req.setHeaders(headers);
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("reportID returned", function() {
    bru.setEnvVar("lab_report_id", res.body.reportID);
  });
  test("sensitivityLevel NORMAL for BLOOD_TEST", function() {
    expect(res.body.sensitivityLevel).to.equal("NORMAL");
  });
}
