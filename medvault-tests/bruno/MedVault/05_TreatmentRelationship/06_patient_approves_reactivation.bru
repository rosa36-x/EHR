meta {
  name: Patient Approves Reactivation
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/treatment-relationships/{{treatment_relationship_id}}/approve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patient_token}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("relationship is now ACTIVE (access resumes only now)", function() {
    expect(res.body.relationshipStatus).to.equal("ACTIVE");
  });
}
