meta {
  name: Reject Permission Request (Patient)
  type: http
  seq: 5
}

script:pre-request {
  const res = await fetch(bru.getEnvVar("base_url") + "/permission-requests", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": "Bearer " + bru.getEnvVar("doctor_token")
    },
    body: JSON.stringify({
      patientID: bru.getEnvVar("patient_id"),
      resourceType: "CONSULTATION",
      resourceID: bru.getEnvVar("sensitive_consultation_id"),
      reason: "Reject-test permission request"
    })
  });
  const data = await res.json();
  bru.setVar("reject_request_id", data.requestID);
}

patch {
  url: {{base_url}}/permission-requests/{{reject_request_id}}/reject
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patient_token}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
}
