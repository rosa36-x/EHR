meta {
  name: Create Consultation
  type: http
  seq: 1
}
post {
  url: {{base_url}}/consultations
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  bru.setVar("consultation_id_new", "CONS" + Date.now());

  const data = new FormData();
  data.append("consultationID", bru.getVar("consultation_id_new"));
  data.append("patientID", bru.getEnvVar("patient_id"));
  data.append("doctorID", bru.getEnvVar("doctor_id"));
  data.append("diagnosis", "Routine general checkup — no significant findings");
  data.append("recordType", "GENERAL");
  data.append("file", fs.createReadStream("/tmp/test_consultation.pdf"));

  req.setBody(data);
  const headers = data.getHeaders();
  headers["Authorization"] = "Bearer " + bru.getEnvVar("doctor_token");
  req.setHeaders(headers);
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("consultationID returned", function() {
    expect(res.body.consultationID).to.be.a("string");
    bru.setEnvVar("consultation_id", res.body.consultationID);
  });
  test("CID returned (IPFS upload)", function() {
    expect(res.body.consultationCID).to.be.a("string");
    expect(res.body.consultationCID.length).to.be.at.least(10);
  });
  test("encryptionKeyRef returned (KMS)", function() {
    expect(res.body.encryptionKeyRef).to.match(/^KEY/);
  });
  test("sensitivityLevel NORMAL for GENERAL record", function() {
    expect(res.body.sensitivityLevel).to.equal("NORMAL");
  });
}
