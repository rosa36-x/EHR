meta {
  name: Update Consultation
  type: http
  seq: 6
}
put {
  url: {{base_url}}/consultations/{{consultation_id}}
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  const data = new FormData();
  data.append("diagnosis", "Routine checkup — follow-up recommended in 3 months");
  data.append("file", fs.createReadStream("/tmp/test_consultation_updated.pdf"));

  req.setBody(data);
  const headers = data.getHeaders();
  headers["Authorization"] = "Bearer " + bru.getEnvVar("doctor_token");
  req.setHeaders(headers);
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("new CID returned (re-uploaded to IPFS)", function() {
    expect(res.body.consultationCID).to.be.a("string");
  });
  test("new encryptionKeyRef (new key generated per update)", function() {
    expect(res.body.encryptionKeyRef).to.match(/^KEY/);
  });
}
