meta {
  name: Create Consultation - Sensitive (Psychiatry)
  type: http
  seq: 2
}
post {
  url: {{base_url}}/consultations
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  bru.setVar("consultation_id_sensitive", "CONS" + Date.now());

  const data = new FormData();
  data.append("consultationID", bru.getVar("consultation_id_sensitive"));
  data.append("patientID", bru.getEnvVar("patient_id"));
  data.append("doctorID", bru.getEnvVar("doctor_id"));
  data.append("diagnosis", "Generalised Anxiety Disorder — initial assessment");
  data.append("recordType", "PSYCHIATRY");
  data.append("file", fs.createReadStream("/tmp/test_consultation.pdf"));

  req.setBody(data);
  const headers = data.getHeaders();
  headers["Authorization"] = "Bearer " + bru.getEnvVar("doctor_token");
  req.setHeaders(headers);
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("sensitivityLevel SENSITIVE for PSYCHIATRY", function() {
    expect(res.body.sensitivityLevel).to.equal("SENSITIVE");
    bru.setEnvVar("sensitive_consultation_id", res.body.consultationID);
  });
}
