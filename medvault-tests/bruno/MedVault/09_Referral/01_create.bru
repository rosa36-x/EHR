meta {
  name: Create Referral
  type: http
  seq: 1
}
post {
  url: {{base_url}}/referrals
  body: multipartForm
  auth: none
}
script:pre-request {
  const fs = require('fs');
  const FormData = require('form-data');

  bru.setVar("referral_id_new", "REF" + Date.now());

  const data = new FormData();
  data.append("referralID", bru.getVar("referral_id_new"));
  data.append("patientID", bru.getEnvVar("patient_id"));
  data.append("fromDoctorID", bru.getEnvVar("doctor_id"));
  data.append("toDoctorID", "DOC0002");
  data.append("referralType", "GENERAL");
  data.append("file", fs.createReadStream("/tmp/test_referral.pdf"));

  req.setBody(data);
  req.setHeaders(data.getHeaders());
}
tests {
  console.log("RESPONSE STATUS:", res.status);
  console.log("RESPONSE BODY:", JSON.stringify(res.body));
  // NOTE: referral route has no authentication middleware — intentional
  // (may be a route-level issue to review during testing).
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("SUCCESS status", function() {
    expect(res.body.status).to.equal("SUCCESS");
  });
  test("referralID returned", function() {
    expect(res.body.referralID).to.be.a("string");
    bru.setEnvVar("referral_id", res.body.referralID);
  });
}
